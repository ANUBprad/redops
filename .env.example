# RedOps Eval — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# APP
APP_ENV=development
APP_NAME=redops-eval
APP_VERSION=0.1.0
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_SECRET_KEY=change-me-to-a-random-secret-key

# SERVER
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USER=redops
DB_PASSWORD=redops
DB_NAME=redops
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# TEMPORAL
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=redops-eval
